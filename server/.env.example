# FUD Campus Care — API server environment
# Copy to server/.env and fill in real values. NEVER commit server/.env.

# Supabase project URL (e.g. https://abcd1234.supabase.co)
SUPABASE_URL=https://norlmdvtfnjvesvpjtmt.supabase.co

# Supabase anon/public key (Project Settings → API → anon key)
SUPABASE_ANON_KEY=sb_publishable_UXtbp3-ou_r3LfSqYUVAWA_JsTuujoA

# Supabase service_role key — SERVER ONLY. Never expose to the frontend.
